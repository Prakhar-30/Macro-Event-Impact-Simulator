# --- Database (any Postgres 15+ with pgvector — local Docker, Neon, Supabase, etc.) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/macroscope

# --- Redis (for BullMQ + SSE pub/sub) ---
REDIS_URL=redis://localhost:6379

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-...

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-run-openssl-rand-base64-32

# --- GitHub OAuth (optional in dev — credentials provider works without it) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Worker ---
WORKER_PORT=4000

# --- Web ---
WEB_PORT=3000

# --- Public-facing URL of the worker (Web reads SSE from here) ---
WORKER_PUBLIC_URL=http://localhost:4000
